<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Set the system screensaver to this app (Settings.Secure.screensaver_components). A regular app does not get
         this permission automatically: grant once via adb `pm grant` (see ScreensaverSetup.kt); without it the app
         still works and shows instructions. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- MapLibre checks whether there is a network connection (ConnectivityReceiver) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/tv_banner"
        android:theme="@style/Theme.Photos"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screensaver (DreamService, see Dream.kt). The label is what system settings show where a picker list
             exists; dream.xml links the gear icon to the app's settings. -->
        <!-- NO separate process (android:process): on Android 11 the system starts android.service.dreams.DreamActivity in
             the app's default process and casts the service's binder; in another process that crashes
             (ClassCastException BinderProxy -> DreamServiceWrapper) and leaves a black screen (tested 21-10-2026). -->
        <service
            android:name=".PhotoDream"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>
        <!-- Screensaver preview (Settings -> Screensaver -> Preview). Exported with DUMP permission: only the app
             itself and the shell (`am start -n com.immichclient.tv/.PreviewActivity`, for testing) can start it. -->
        <activity
            android:name=".PreviewActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <activity
            android:name=".PermissionsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <activity
            android:name=".ScreensaverHelpActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <!-- Screensaver settings (settingsActivity in dream.xml): opens the app in Settings -> Screensaver -->
        <activity-alias
            android:name=".ScreensaverSettings"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/dream_name" />

        <!-- Set key + server via adb without opening the app (see KeyReceiver). Only shell/system has DUMP,
             not regular apps. -->
        <receiver
            android:name=".KeyReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.immichclient.tv.SET_KEY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
